APP_ENV=development
APP_TIMEZONE=America/Sao_Paulo
BASE_URL=http://localhost/Minha_loja-Api
SESSION_SECURE=false
LOGIN_WINDOW_MINUTES=15
LOGIN_MAX_ATTEMPTS_EMAIL=3
LOGIN_MAX_ATTEMPTS_IP=10
# Ative somente se o servidor de origem aceitar requisicoes exclusivamente do Cloudflare.
TRUST_CLOUDFLARE_PROXY=false
XML_MAX_BYTES=2097152
XML_MAX_ITEMS=500
AUDIT_RETENTION_DAYS=365
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=minha_loja2
DB_USER=minha_loja_app
DB_PASS=troque_por_uma_senha_forte
MAIL_FROM_ADDRESS=no-reply@minhaloja.local
MAIL_FROM_NAME=Minha Loja
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ENCRYPTION=tls
